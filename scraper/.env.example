# Copy to .env and fill in. .env is gitignored -- NEVER commit real tokens.
# Repo public hai: agar galti se token commit ho jaaye to turant revoke karo.

# Comma-separated. Jitne free Apify keys hain sab daal do -- script ek ka
# credit khatam hote hi apne aap agle par rotate kar deti hai.
APIFY_TOKENS=apify_api_xxxxxxxxxxxx,apify_api_yyyyyyyyyyyy

# Airtable personal access token. Scopes chahiye:
#   data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=patXXXXXXXX.yyyyyyyyyyyyyyyy
